<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>Xylab.Workflows.LogicApps</AssemblyName>
    <RootNamespace>Xylab.Workflows.LogicApps</RootNamespace>
    <NoWarn>$(NoWarn);MSB3270;NU5104;MSB3246</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <Import Project="..\..\build\NugetPackage.Backend.props" />

  <ItemGroup>
    <EmbeddedResource Include="Engine\AzureConfig.json" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="ICU4N" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Azure.Workflows.WebJobs.Extension" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Include="Microsoft.CodeAnalysis.Scripting.Common" />
    <PackageReference Include="Microsoft.SemanticKernel.Core" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

</Project>
